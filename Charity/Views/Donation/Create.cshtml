@model Charity.Models.Donation

@{
    ViewBag.Title = "Quyên góp mô phỏng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var campaign = ViewBag.Campaign as Charity.Models.Campaign;
}

<div class="container mt-4 mb-5" style="max-width: 760px">

    <h2 class="mb-4">Quyên góp mô phỏng</h2>

    @if (campaign != null)
    {
        <div class="alert alert-info">
            <h5 class="mb-2">@campaign.Title</h5>

            <div>
                Mục tiêu:
                <strong>@campaign.TargetAmount.ToString("N0") VNĐ</strong>
            </div>

            <small>
                Đây là giao dịch demo, không thực hiện chuyển tiền thật.
            </small>
        </div>
    }

    @using (Html.BeginForm(
        "Create",
        "Donation",
        FormMethod.Post,
        new { @class = "card card-body shadow-sm" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.CampaignId)

        @Html.ValidationSummary(
            false,
            "Vui lòng kiểm tra thông tin:",
            new { @class = "alert alert-danger" })

        <div class="mb-3">
            <label for="Amount" class="form-label">
                Số tiền quyên góp (VNĐ) *
            </label>

            @Html.TextBoxFor(m => m.Amount, new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                max = "1000000000000",
                step = "1",
                required = "required",
                placeholder = "Ví dụ: 100000"
            })

            @Html.ValidationMessageFor(
                m => m.Amount,
                "",
                new { @class = "text-danger" })

            <small class="text-muted">
                Nhập số tiền nguyên VNĐ, ví dụ 100000 hoặc 1000000.
            </small>
        </div>

        <div class="mb-3">
            <label for="PaymentMethod" class="form-label">
                Phương thức quyên góp
            </label>

            @Html.DropDownListFor(
                m => m.PaymentMethod,
                new SelectList(
                    new[]
                    {
                        new { Value = "Mô phỏng", Text = "Mô phỏng" },
                        new { Value = "Chuyển khoản demo", Text = "Chuyển khoản demo" },
                        new { Value = "Ví điện tử demo", Text = "Ví điện tử demo" }
                    },
                    "Value",
                    "Text",
                    Model.PaymentMethod ?? "Mô phỏng"
                ),
                new { @class = "form-select" })
        </div>

        <div class="mb-3">
            <label for="Message" class="form-label">
                Lời nhắn
            </label>

            @Html.TextAreaFor(m => m.Message, 3, 10, new
            {
                @class = "form-control",
                maxlength = "500",
                placeholder = "Gửi lời nhắn đến chiến dịch..."
            })

            @Html.ValidationMessageFor(
                m => m.Message,
                "",
                new { @class = "text-danger" })

            <small class="text-muted">
                Tối đa 500 ký tự.
            </small>
        </div>

        <div class="form-check mb-4">
            @Html.CheckBox(
                "IsAnonymous",
                Model.IsAnonymous ?? false,
                new { @class = "form-check-input" })

            <label class="form-check-label" for="IsAnonymous">
                Hiển thị ẩn danh
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                ♥ Xác nhận quyên góp demo
            </button>

            @Html.ActionLink(
                "Hủy",
                "Details",
                "Campaign",
                new { id = Model.CampaignId },
                new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>