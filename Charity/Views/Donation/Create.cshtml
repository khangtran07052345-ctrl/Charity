
@using System.Linq
@model Charity.Models.Donation

@{
    ViewBag.Title = "Quyên góp";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var campaign = ViewBag.Campaign as Charity.Models.Campaign;
    var moneyMethods = ViewBag.MoneyMethods as string[] ?? new string[0];
    var deliveryMethods = ViewBag.DeliveryMethods as string[] ?? new string[0];

    string selMethod = (!string.IsNullOrEmpty(Model.PaymentMethod) &&
                        moneyMethods.Contains(Model.PaymentMethod))
                        ? Model.PaymentMethod
                        : (moneyMethods.Length > 0 ? moneyMethods[0] : "");
}

<style>
    #undoBtn.btn-outline-warning {
        color: #b45309;
        border-color: #f59e0b;
        background-color: #fffbeb;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }

        #undoBtn.btn-outline-warning:hover {
            color: #fff;
            background-color: #d97706;
            border-color: #d97706;
        }

    .btn-outline-info {
        color: #0369a1;
        border-color: #38bdf8;
        background-color: #f0f9ff;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }

        .btn-outline-info:hover {
            color: #fff;
            background-color: #0284c7;
            border-color: #0284c7;
        }

    .quick-amount.active {
        color: #fff;
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    #submitBtn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 760px">

    <h2 class="mb-4">Quyên góp</h2>

    @if (campaign != null)
    {
        <div class="alert alert-info">
            <h5 class="mb-2">@campaign.Title</h5>
            <div>
                Mục tiêu:
                <strong>@campaign.TargetAmount.ToString("N0") VNĐ</strong>
            </div>
            <small>Đây là giao dịch demo, không thực hiện chuyển tiền thật.</small>
        </div>
    }

    @using (Html.BeginForm("Create", "Donation", FormMethod.Post,
        new { @class = "card card-body shadow-sm", id = "donateForm" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.CampaignId)
        @Html.HiddenFor(m => m.DonationType)
        @Html.HiddenFor(m => m.TransactionCode)

        @Html.ValidationSummary(false, "Vui lòng kiểm tra thông tin:", new { @class = "alert alert-danger" })

        <!-- CHỌN LOẠI QUYÊN GÓP -->
        <div class="btn-group w-100 mb-4" role="group">
            <button type="button" id="tabMoney" class="btn btn-outline-primary">
                💰 Quyên góp tiền
            </button>

            <button type="button" id="tabKind" class="btn btn-outline-primary">
                📦 Quyên góp hiện vật
            </button>
        </div>

        <!-- ================= QUYÊN GÓP TIỀN ================= -->
        <fieldset id="moneyBox">

            <div class="mb-3">
                <label class="form-label">Chọn nhanh số tiền</label>

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var a in new[] { 50000, 100000, 200000, 500000, 1000000 })
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm quick-amount"
                                data-amount="@a">
                            @a.ToString("N0")đ
                        </button>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label for="Amount" class="form-label">
                    Số tiền quyên góp (VNĐ) *
                </label>

                @Html.TextBox("Amount",
                         Model.Amount > 0 ? Model.Amount.ToString("0") : "",
                         new
                         {
                             @class = "form-control",
                             type = "number",
                             min = "1",
                             max = "1000000000000",
                             step = "1",
                             required = "required",
                             placeholder = "Ví dụ: 100000"
                         })

                @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Phương thức thanh toán</label>

                @foreach (var m in moneyMethods)
                {
                    <div class="form-check">
                        <input class="form-check-input pay-method"
                               type="radio"
                               name="PaymentMethod"
                               id="pm_@(Array.IndexOf(moneyMethods, m))"
                               value="@m"
                               @(m == selMethod ? "checked" : "") />

                        <label class="form-check-label"
                               for="pm_@(Array.IndexOf(moneyMethods, m))">
                            @m
                        </label>
                    </div>
                }
            </div>

            <!-- THÔNG TIN CHUYỂN KHOẢN VÀ QR -->
            <div id="bankPanel"
                 class="border rounded p-3 mb-3 bg-light"
                 data-bank="@ViewBag.BankCode"
                 data-acc="@ViewBag.BankAccountNo"
                 data-name="@ViewBag.BankAccountName">

                <div class="row g-3">

                    <div class="col-md-7">

                        <div class="mb-2">
                            <span class="text-muted">Ngân hàng:</span>
                            <strong>@ViewBag.BankName</strong>
                        </div>

                        <div class="mb-2">
                            <span class="text-muted">Số tài khoản:</span>

                            <strong id="accNo">@ViewBag.BankAccountNo</strong>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary ms-1 copy-btn"
                                    data-target="accNo">
                                Copy
                            </button>
                        </div>

                        <div class="mb-2">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <strong>@ViewBag.BankAccountName</strong>
                        </div>

                        <div class="mb-2">
                            <span class="text-muted">Số tiền:</span>
                            <strong id="amountText" class="text-success">0</strong> VNĐ
                        </div>

                        <div class="mb-2">
                            <span class="text-muted">Nội dung chuyển khoản:</span>

                            <strong id="transferCode">@Model.TransactionCode</strong>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary ms-1 copy-btn"
                                    data-target="transferCode">
                                Copy
                            </button>
                        </div>

                        <small class="text-muted">
                            Vui lòng giữ nguyên nội dung chuyển khoản để hệ thống đối soát. (Demo)
                        </small>

                    </div>

                    <div class="col-md-5 text-center">
                        <img id="qrImg"
                             src=""
                             alt="QR chuyển khoản"
                             class="img-fluid border rounded bg-white"
                             style="max-width: 220px" />

                        <div>
                            <small class="text-muted">Quét bằng app ngân hàng</small>
                        </div>
                    </div>

                </div>
            </div>

            <!-- THÔNG TIN VÍ -->
            <div id="walletPanel"
                 class="border rounded p-3 mb-3 bg-light"
                 style="display:none">

                <div class="mb-1">
                    Số ví nhận (demo):
                    <strong>@ViewBag.EWalletPhone</strong>
                </div>

                <small class="text-muted">
                    Mở ví, chọn "Chuyển tiền", nhập số ví trên và số tiền đã nhập phía trên. (Demo)
                </small>
            </div>

        </fieldset>

        <!-- ================= QUYÊN GÓP HIỆN VẬT ================= -->
        <fieldset id="kindBox" style="display:none" disabled>

            <div class="mb-3">
                <label for="ItemName" class="form-label">Tên hiện vật *</label>

                @Html.TextBox("ItemName", Model.ItemName, new
                {
                    @class = "form-control",
                    maxlength = "200",
                    required = "required",
                    placeholder = "Ví dụ: Gạo ST25, mì gói, áo ấm, sách vở..."
                })

                @Html.ValidationMessageFor(m => m.ItemName, "", new { @class = "text-danger" })
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label for="Quantity" class="form-label">Số lượng *</label>

                    @Html.TextBox("Quantity",
                             Model.Quantity.HasValue ? Model.Quantity.Value.ToString("0") : "",
                             new
                             {
                                 @class = "form-control",
                                 type = "number",
                                 min = "1",
                                 step = "1",
                                 required = "required"
                             })

                    @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    <label for="Unit" class="form-label">Đơn vị *</label>

                    @Html.TextBox("Unit", Model.Unit, new
                    {
                        @class = "form-control",
                        maxlength = "30",
                        list = "unitList",
                        required = "required",
                        placeholder = "kg, bao, thùng, bộ..."
                    })

                    <datalist id="unitList">
                        <option value="kg"></option>
                        <option value="bao"></option>
                        <option value="thùng"></option>
                        <option value="hộp"></option>
                        <option value="chai"></option>
                        <option value="bộ"></option>
                        <option value="cái"></option>
                    </datalist>

                    @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="mb-3">
                <label for="EstimatedValue" class="form-label">
                    Giá trị ước tính (VNĐ, không bắt buộc)
                </label>

                @Html.TextBox("EstimatedValue",
                         Model.EstimatedValue.HasValue ? Model.EstimatedValue.Value.ToString("0") : "",
                         new
                         {
                             @class = "form-control",
                             type = "number",
                             min = "0",
                             step = "1",
                             placeholder = "Chỉ để tham khảo, không cộng vào số tiền đã quyên góp"
                         })

                @Html.ValidationMessageFor(m => m.EstimatedValue, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label for="DeliveryMethod" class="form-label">
                    Hình thức giao hàng *
                </label>

                <select name="DeliveryMethod"
                        id="DeliveryMethod"
                        class="form-select"
                        required>

                    <option value="">-- Chọn hình thức giao hàng --</option>

                    @foreach (var d in deliveryMethods)
                    {
                        <option value="@d" @(Model.DeliveryMethod == d ? "selected" : "")>
                            @d
                        </option>
                    }

                </select>

                @Html.ValidationMessageFor(m => m.DeliveryMethod, "", new { @class = "text-danger" })
            </div>

            <!-- TỰ MANG ĐẾN -->
            <div id="selfBringBox"
                 class="border rounded p-3 mb-3 bg-light"
                 style="display:none">

                <label class="form-label fw-bold text-primary">
                    Lựa chọn cách thức tự mang đến:
                </label>

                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="radio"
                           name="DeliverySubOption"
                           id="subOption1"
                           value="Tự mang đi"
                           checked />

                    <label class="form-check-label" for="subOption1">
                        Luồng 1: Tự 1 mình mang đến trực tiếp địa điểm tiếp nhận.
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input"
                           type="radio"
                           name="DeliverySubOption"
                           id="subOption2"
                           value="Viết thư tham gia" />

                    <label class="form-check-label" for="subOption2">
                        Luồng 2: Viết thư xin cùng được tham gia quyên góp.
                    </label>
                </div>

                <div id="letterBox"
                     style="display:none"
                     class="mt-3 pt-2 border-top">

                    <label for="DonationLetter" class="form-label">
                        Nội dung bức thư gửi gắm yêu thương:
                    </label>

                    <textarea name="DonationLetter"
                              id="DonationLetter"
                              class="form-control"
                              rows="3"
                              placeholder="Viết đôi dòng tâm tư, nguyện vọng muốn đồng hành cùng chiến dịch..."></textarea>
                </div>

            </div>

            <!-- NHỜ ĐẾN LẤY -->
            <div id="shipperBox"
                 class="border rounded p-3 mb-3 bg-light"
                 style="display:none">

                <div class="text-info fw-bold mb-2">
                    🚗 Đội ngũ Shipper sẽ liên hệ và đến tận nơi nhận hàng.
                </div>

                <label for="PickupAddress" class="form-label">
                    Địa chỉ nhận hàng chi tiết *
                </label>

                @Html.TextArea("PickupAddress", Model.PickupAddress, 2, 10, new
                {
                    @class = "form-control",
                    maxlength = "300",
                    placeholder = "Số nhà, tên đường, phường/xã, quận/huyện..."
                })

                @Html.ValidationMessageFor(m => m.PickupAddress, "", new { @class = "text-danger" })
            </div>

            <!-- GỬI BƯU ĐIỆN -->
            <div id="postalBox"
                 class="border rounded p-3 mb-3 bg-light"
                 style="display:none">

                <div class="text-warning fw-bold mb-2">
                    📦 Gửi qua đường bưu điện / đơn vị vận chuyển ngoài.
                </div>

                <div class="mb-2">
                    <label for="PostalTrackingCode" class="form-label">
                        Mã vận đơn bưu điện *
                    </label>

                    <div class="input-group">
                        <input type="text"
                               name="PostalTrackingCode"
                               id="PostalTrackingCode"
                               class="form-control"
                               placeholder="Nhấn nút bên cạnh để tạo mã demo..."
                               maxlength="100" />

                        <button type="button"
                                id="btnOpenPostalDemo"
                                class="btn btn-outline-warning text-dark fw-semibold">
                            🌐 Mở trang Bưu điện (Tạo mã)
                        </button>
                    </div>
                </div>

                <small class="text-muted">
                    Hệ thống tạo mã vận đơn giả lập để phục vụ quy trình demo.
                </small>
            </div>

            <div class="mb-3">
                <label for="ContactPhone" class="form-label">
                    Số điện thoại liên hệ *
                </label>

                @Html.TextBox("ContactPhone", Model.ContactPhone, new
                {
                    @class = "form-control",
                    maxlength = "11",
                    required = "required",
                    placeholder = "0901234567"
                })

                @Html.ValidationMessageFor(m => m.ContactPhone, "", new { @class = "text-danger" })
            </div>

            <div class="alert alert-warning py-2">
                <small>
                    Quyên góp hiện vật sẽ ở trạng thái
                    <strong>chờ xác nhận</strong>
                    cho đến khi quản trị viên xác nhận đã nhận hàng.
                </small>
            </div>

        </fieldset>

        <!-- ================= THÔNG TIN DÙNG CHUNG ================= -->

        <div class="mb-3">
            <label for="Message" class="form-label">Lời nhắn</label>

            @Html.TextAreaFor(m => m.Message, 3, 10, new
            {
                @class = "form-control",
                maxlength = "500",
                placeholder = "Gửi lời nhắn đến chiến dịch..."
            })

            @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })

            <small class="text-muted">Tối đa 500 ký tự.</small>
        </div>

        <div class="form-check mb-4">
            @Html.CheckBox("IsAnonymous", Model.IsAnonymous ?? false,
                     new { @class = "form-check-input" })

            <label class="form-check-label" for="IsAnonymous">
                Hiển thị ẩn danh
            </label>
        </div>

        <!-- CÁC NÚT CHỨC NĂNG -->
        <div class="d-flex flex-wrap gap-2">

            <button type="submit" id="submitBtn" class="btn btn-primary">
                ♥ Xác nhận
            </button>

            <button type="reset"
                    id="undoBtn"
                    class="btn btn-outline-warning">
                ↶ Undo / Hoàn tác
            </button>

            @Html.ActionLink("Lịch sử giao dịch",
                     "History", "Donation", null,
                     new { @class = "btn btn-outline-info" })

            @Html.ActionLink("Hủy",
                     "Details", "Campaign",
                     new { id = Model.CampaignId },
                     new { @class = "btn btn-outline-secondary" })

        </div>
    }

</div>

@section Scripts {

    <script>
(function () {

            var form = document.getElementById('donateForm');

            if (!form) return;

            var typeInput = document.getElementById('DonationType');

            var moneyBox = document.getElementById('moneyBox');
            var kindBox = document.getElementById('kindBox');

            var tabMoney = document.getElementById('tabMoney');
            var tabKind = document.getElementById('tabKind');

            var submitBtn = document.getElementById('submitBtn');

            var amountInput = document.getElementById('Amount');

            var bankPanel = document.getElementById('bankPanel');
            var walletPanel = document.getElementById('walletPanel');

            var qrImg = document.getElementById('qrImg');
            var amountText = document.getElementById('amountText');

            var transferCodeEl = document.getElementById('transferCode');

            var code = transferCodeEl
                ? transferCodeEl.textContent.trim()
                : '';

            var isSubmitting = false;

            // =========================
            // KIỂM TRA PHƯƠNG THỨC THANH TOÁN
            // =========================

            function isBank() {
                var selected = document.querySelector('input.pay-method:checked');

                return !selected ||
                    selected.value.indexOf('Chuyển khoản') === 0;
            }

            // =========================
            // CẬP NHẬT THANH TOÁN VÀ QR
            // =========================

            function updatePayment() {

                var bank = isBank();

                if (bankPanel) {
                    bankPanel.style.display = bank ? '' : 'none';
                }

                if (walletPanel) {
                    walletPanel.style.display = bank ? 'none' : '';
                }

                var amount = amountInput
                    ? (parseInt(amountInput.value, 10) || 0)
                    : 0;

                if (amountText) {
                    amountText.textContent = amount.toLocaleString('vi-VN');
                }

                if (bank && qrImg && bankPanel) {

                    var bankCode = bankPanel.getAttribute('data-bank');
                    var accountNo = bankPanel.getAttribute('data-acc');
                    var accountName = bankPanel.getAttribute('data-name') || '';

                    if (bankCode && accountNo) {

                        qrImg.src =
                            'https://img.vietqr.io/image/' +
                            bankCode + '-' + accountNo +
                            '-compact2.png?amount=' + amount +
                            '&addInfo=' + encodeURIComponent(code) +
                            '&accountName=' + encodeURIComponent(accountName);
                    }
                }

                if (typeInput && submitBtn && typeInput.value === 'Money') {

                    submitBtn.textContent = bank
                        ? '✔ Tôi đã chuyển khoản'
                        : '♥ Xác nhận quyên góp';
                }
            }

            // =========================
            // CHỌN LOẠI QUYÊN GÓP
            // =========================

            function setType(type) {

                var isMoney = type === 'Money';

                if (typeInput) {
                    typeInput.value = isMoney ? 'Money' : 'InKind';
                }

                // Quan trọng:
                // Vô hiệu hóa các trường required thuộc nhóm đang bị ẩn.
                // Nhờ đó trình duyệt không chặn gửi form.

                if (moneyBox) {
                    moneyBox.disabled = !isMoney;
                    moneyBox.style.display = isMoney ? '' : 'none';
                }

                if (kindBox) {
                    kindBox.disabled = isMoney;
                    kindBox.style.display = isMoney ? 'none' : '';
                }

                if (tabMoney) {
                    tabMoney.classList.toggle('active', isMoney);
                }

                if (tabKind) {
                    tabKind.classList.toggle('active', !isMoney);
                }

                if (isMoney) {
                    updatePayment();
                } else {
                    if (submitBtn) {
                        submitBtn.textContent =
                            '📦 Gửi đăng ký quyên góp hiện vật';
                    }
                }
            }

            if (tabMoney) {
                tabMoney.addEventListener('click', function () {
                    setType('Money');
                });
            }

            if (tabKind) {
                tabKind.addEventListener('click', function () {
                    setType('InKind');
                });
            }

            // =========================
            // CHỌN NHANH SỐ TIỀN
            // =========================

            document.querySelectorAll('.quick-amount').forEach(function (button) {

                button.addEventListener('click', function () {

                    var value = button.getAttribute('data-amount');

                    if (amountInput && value) {

                        amountInput.value = value;

                        updatePayment();

                        document.querySelectorAll('.quick-amount').forEach(function (item) {
                            item.classList.remove('active');
                        });

                        button.classList.add('active');
                    }
                });
            });

            if (amountInput) {
                amountInput.addEventListener('input', function () {

                    document.querySelectorAll('.quick-amount').forEach(function (item) {
                        item.classList.remove('active');
                    });

                    updatePayment();
                });
            }

            // =========================
            // THAY ĐỔI PHƯƠNG THỨC THANH TOÁN
            // =========================

            document.querySelectorAll('.pay-method').forEach(function (radio) {

                radio.addEventListener('change', function () {
                    updatePayment();
                });
            });

            // =========================
            // COPY THÔNG TIN
            // =========================

            document.querySelectorAll('.copy-btn').forEach(function (button) {

                button.addEventListener('click', function () {

                    var targetId = button.getAttribute('data-target');
                    var target = document.getElementById(targetId);

                    if (!target) return;

                    var text = target.textContent.trim();

                    if (navigator.clipboard && window.isSecureContext) {

                        navigator.clipboard.writeText(text).then(function () {

                            var oldText = button.textContent;

                            button.textContent = 'Đã copy';

                            window.setTimeout(function () {
                                button.textContent = oldText;
                            }, 1200);

                        }).catch(function () {
                            alert('Không thể copy tự động. Vui lòng sao chép thủ công.');
                        });

                    } else {

                        alert('Trình duyệt không hỗ trợ copy tự động. Vui lòng sao chép thủ công: ' + text);
                    }
                });
            });

            // =========================
            // GIAO HÀNG HIỆN VẬT
            // =========================

            var deliverySelect = document.getElementById('DeliveryMethod');

            var selfBringBox = document.getElementById('selfBringBox');
            var shipperBox = document.getElementById('shipperBox');
            var postalBox = document.getElementById('postalBox');

            var subOption1 = document.getElementById('subOption1');
            var subOption2 = document.getElementById('subOption2');

            var letterBox = document.getElementById('letterBox');

            function updateDeliveryUI() {

                var value = deliverySelect
                    ? deliverySelect.value
                    : '';

                if (selfBringBox) selfBringBox.style.display = 'none';
                if (shipperBox) shipperBox.style.display = 'none';
                if (postalBox) postalBox.style.display = 'none';

                if (value === 'Tự mang đến') {

                    if (selfBringBox) {
                        selfBringBox.style.display = '';
                    }

                } else if (value === 'Nhờ đến lấy') {

                    if (shipperBox) {
                        shipperBox.style.display = '';
                    }

                } else if (value === 'Gửi bưu điện') {

                    if (postalBox) {
                        postalBox.style.display = '';
                    }
                }
            }

            if (deliverySelect) {
                deliverySelect.addEventListener('change', updateDeliveryUI);
            }

            // =========================
            // CHỌN NHÁNH TỰ MANG ĐẾN
            // =========================

            if (subOption2 && subOption1) {

                subOption2.addEventListener('change', function () {

                    if (subOption2.checked) {

                        if (letterBox) {
                            letterBox.style.display = '';
                        }

                        var confirmed = confirm(
                            '♥ Bạn có chắc chắn với điều mà bạn muốn lan tỏa tình thương này không?'
                        );

                        if (!confirmed) {

                            subOption1.checked = true;

                            if (letterBox) {
                                letterBox.style.display = 'none';
                            }
                        }
                    }
                });

                subOption1.addEventListener('change', function () {

                    if (subOption1.checked && letterBox) {
                        letterBox.style.display = 'none';
                    }
                });
            }

            // =========================
            // TẠO MÃ BƯU ĐIỆN DEMO
            // =========================

            var btnOpenPostal = document.getElementById('btnOpenPostalDemo');

            if (btnOpenPostal) {

                btnOpenPostal.addEventListener('click', function () {

                    var randomCode =
                        'VNPT-' +
                        Math.floor(10000000 + Math.random() * 90000000);

                    var confirmed = confirm(
                        'Hệ thống đang mở cổng thông tin Bưu điện Demo.\n\n' +
                        'Bạn có muốn tạo phiếu gửi và lấy mã vận đơn không?'
                    );

                    if (confirmed) {

                        var postalInput =
                            document.getElementById('PostalTrackingCode');

                        if (postalInput) {
                            postalInput.value = randomCode;
                        }

                        alert(
                            '✔ Đã tạo mã bưu điện Demo: ' +
                            randomCode +
                            '\nMã đã được điền vào phiếu quyên góp!'
                        );
                    }
                });
            }

            // =========================
            // XỬ LÝ KHI GỬI FORM
            // =========================

            form.addEventListener('submit', function (event) {

                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                // Chỉ gửi nhóm trường tương ứng với loại quyên góp.
                var currentType = typeInput
                    ? typeInput.value
                    : 'Money';

                if (currentType === 'InKind') {

                    if (moneyBox) moneyBox.disabled = true;
                    if (kindBox) kindBox.disabled = false;

                } else {

                    if (kindBox) kindBox.disabled = true;
                    if (moneyBox) moneyBox.disabled = false;
                }

                // Nếu dữ liệu hợp lệ thì khóa nút để tránh gửi nhiều lần.
                if (form.checkValidity()) {

                    isSubmitting = true;

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.textContent = '⏳ Đang xử lý...';
                    }

                } else {

                    // Nếu không hợp lệ, để trình duyệt hiển thị thông báo.
                    isSubmitting = false;
                }
            });

            // =========================
            // NÚT UNDO / HOÀN TÁC
            // =========================

            form.addEventListener('reset', function () {

                window.setTimeout(function () {

                    var currentType = typeInput
                        ? typeInput.value
                        : 'Money';

                    setType(
                        currentType === 'InKind'
                            ? 'InKind'
                            : 'Money'
                    );

                    updatePayment();
                    updateDeliveryUI();

                    document.querySelectorAll('.quick-amount').forEach(function (item) {
                        item.classList.remove('active');
                    });

                    isSubmitting = false;

                    if (submitBtn) {
                        submitBtn.disabled = false;
                    }

                }, 0);
            });

            // =========================
            // KHỞI TẠO GIAO DIỆN
            // =========================

            var initialType = typeInput
                ? typeInput.value
                : 'Money';

            setType(
                initialType === 'InKind'
                    ? 'InKind'
                    : 'Money'
            );

            updateDeliveryUI();

})();
    </script>

}
