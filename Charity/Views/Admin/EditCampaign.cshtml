
@model Charity.Models.Campaign

@{
    ViewBag.Title = "Sửa chiến dịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5" style="max-width: 850px">

    <h2 class="mb-4">Sửa chiến dịch #@Model.Id</h2>

    @using (Html.BeginForm(
        "EditCampaign",
        "Admin",
        FormMethod.Post,
        new
        {
            @class = "card card-body shadow-sm",
            id = "editCampaignForm",
            enctype = "multipart/form-data"
        }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        @Html.ValidationSummary(
            false,
            "Vui lòng kiểm tra dữ liệu:",
            new { @class = "alert alert-danger" }
        )

        <!-- TÊN CHIẾN DỊCH -->
        <div class="mb-3">
            <label class="form-label" for="Title">
                Tên chiến dịch *
            </label>

            @Html.TextBoxFor(m => m.Title, new
            {
                @class = "form-control",
                maxlength = "200",
                required = "required"
            })

            @Html.ValidationMessageFor(
                m => m.Title,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <!-- DANH MỤC -->
        <div class="mb-3">
            <label class="form-label" for="CategoryId">
                Danh mục
            </label>

            @Html.DropDownList(
                "CategoryId",
                (SelectList)ViewBag.CategoryId,
                "-- Không chọn --",
                new { @class = "form-select" }
            )
        </div>

        <!-- MÔ TẢ -->
        <div class="mb-3">
            <label class="form-label" for="Description">
                Mô tả *
            </label>

            @Html.TextAreaFor(m => m.Description, 5, 10, new
            {
                @class = "form-control",
                required = "required"
            })

            @Html.ValidationMessageFor(
                m => m.Description,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <!-- MỤC TIÊU -->
        <div class="mb-3">
            <label class="form-label" for="TargetAmount">
                Mục tiêu (VNĐ) *
            </label>

            @Html.TextBoxFor(m => m.TargetAmount, new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                step = "1",
                required = "required"
            })

            <small class="text-muted">
                Nhập số tiền nguyên VNĐ, không cần nhập phần thập phân.
            </small>

            @Html.ValidationMessageFor(
                m => m.TargetAmount,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <!-- NGÀY BẮT ĐẦU VÀ KẾT THÚC -->
        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label" for="StartDate">
                    Ngày bắt đầu *
                </label>

                <input id="StartDate"
                       name="StartDate"
                       type="date"
                       class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")"
                       required />

                @Html.ValidationMessage(
                    "StartDate",
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label" for="EndDate">
                    Ngày kết thúc *
                </label>

                <input id="EndDate"
                       name="EndDate"
                       type="date"
                       class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")"
                       required />

                @Html.ValidationMessage(
                    "EndDate",
                    "",
                    new { @class = "text-danger" }
                )
            </div>

        </div>

        <!-- CHỌN ẢNH TỪ MÁY TÍNH -->
        <div class="mb-3">

            <label class="form-label" for="campaignImage">
                Chọn ảnh chiến dịch
            </label>

            <input type="file"
                   name="campaignImage"
                   id="campaignImage"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            <small class="text-muted">
                Chọn ảnh JPG, JPEG, PNG, GIF hoặc WEBP.
                Dung lượng tối đa 5 MB.
            </small>

            @Html.ValidationMessage(
                "ImageUrl",
                "",
                new { @class = "text-danger" }
            )

            <div class="mt-3">

                <p class="mb-2">Ảnh xem trước:</p>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img id="imagePreview"
                         src="@Url.Content(Model.ImageUrl)"
                         alt="Ảnh chiến dịch"
                         style="max-width: 280px;
                                max-height: 200px;
                                object-fit: cover;
                                border-radius: 8px;
                                border: 1px solid #ddd;" />
                }
                else
                {
                    <img id="imagePreview"
                         alt="Ảnh xem trước"
                         style="display: none;
                                max-width: 280px;
                                max-height: 200px;
                                object-fit: cover;
                                border-radius: 8px;
                                border: 1px solid #ddd;" />
                }

            </div>
        </div>

        <!-- TRẠNG THÁI -->
        <div class="mb-4">
            <label class="form-label" for="Status">
                Trạng thái
            </label>

            @Html.DropDownListFor(
                m => m.Status,
                new SelectList(
                    new[]
                    {
                        new { Value = 0, Text = "Đang hoạt động" },
                        new { Value = 1, Text = "Đã đóng" },
                        new { Value = 2, Text = "Hoàn thành" }
                    },
                    "Value",
                    "Text",
                    Model.Status ?? 0
                ),
                new { @class = "form-select" }
            )

            @Html.ValidationMessageFor(
                m => m.Status,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <!-- NÚT -->
        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                Lưu thay đổi
            </button>

            @Html.ActionLink(
                "Hủy",
                "Campaigns",
                "Admin",
                null,
                new { @class = "btn btn-outline-secondary" }
            )

        </div>
    }

</div>

<script>
        document.addEventListener("DOMContentLoaded", function () {

            var form = document.getElementById("editCampaignForm");
            var imageInput = document.getElementById("campaignImage");
            var preview = document.getElementById("imagePreview");

            var startInput = document.getElementById("StartDate");
            var endInput = document.getElementById("EndDate");
            var targetInput = document.getElementById("TargetAmount");

            // XEM TRƯỚC ẢNH ĐƯỢC CHỌN
            if (imageInput && preview) {

                imageInput.addEventListener("change", function () {

                    var file = this.files[0];

                    if (!file) return;

                    var allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/gif",
                        "image/webp"
                    ];

                    if (!allowedTypes.includes(file.type)) {
                        alert("Vui lòng chọn ảnh JPG, PNG, GIF hoặc WEBP.");
                        this.value = "";
                        return;
                    }

                    if (file.size > 5 * 1024 * 1024) {
                        alert("Ảnh không được vượt quá 5 MB.");
                        this.value = "";
                        return;
                    }

                    preview.src = URL.createObjectURL(file);
                    preview.style.display = "block";
                });
            }

            // KIỂM TRA DỮ LIỆU TRƯỚC KHI LƯU
            if (form && startInput && endInput && targetInput) {

                form.addEventListener("submit", function (event) {

                    var startDate = startInput.value;
                    var endDate = endInput.value;
                    var targetAmount = Number(targetInput.value);

                    if (
                        !targetInput.value ||
                        !Number.isFinite(targetAmount) ||
                        targetAmount <= 0
                    ) {
                        event.preventDefault();
                        alert("Mục tiêu quyên góp phải lớn hơn 0.");
                        targetInput.focus();
                        return;
                    }

                    if (!startDate || !endDate) {
                        event.preventDefault();
                        alert("Vui lòng nhập đầy đủ ngày bắt đầu và ngày kết thúc.");
                        return;
                    }

                    if (endDate <= startDate) {
                        event.preventDefault();
                        alert("Ngày kết thúc phải sau ngày bắt đầu.");
                        endInput.focus();
                        return;
                    }
                });
            }
        });
</script>
