
@model Charity.Models.User

@{
    ViewBag.Title = "Chỉnh sửa người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Chỉnh sửa người dùng</h2>
        <p class="text-muted">
            Cập nhật thông tin tài khoản trong hệ thống CHARITY
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.Id)

                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và tên</label>
                    @Html.TextBoxFor(m => m.FullName, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập họ và tên",
                        required = "required"
                    })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    @Html.TextBoxFor(m => m.Email, new
                    {
                        @class = "form-control",
                        type = "email",
                        placeholder = "example@gmail.com",
                        required = "required"
                    })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.PhoneNumber, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập số điện thoại"
                    })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Vai trò</label>

                    <select name="Role" class="form-select" required>
                        <option value="User"
                                @(Model.Role == "User" ? "selected" : "")>
                            Người dùng (User)
                        </option>

                        <option value="Admin"
                                @(Model.Role == "Admin" ? "selected" : "")>
                            Quản trị viên (Admin)
                        </option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Mật khẩu mới
                    </label>

                    <input type="password"
                           name="Password"
                           class="form-control"
                           placeholder="Để trống nếu không muốn đổi mật khẩu" />

                    <small class="text-muted">
                        Chỉ nhập khi bạn muốn thay đổi mật khẩu tài khoản.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a href="@Url.Action("Users", "Admin")"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            }

        </div>
    </div>

</div>
