<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CHARITY</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">


    <!-- ================================
         CHARITY HEADER
    ================================= -->

    <header class="charity-header">

        <!-- Thanh thông tin phía trên -->
        <div class="charity-topbar">
            <div class="container charity-topbar-inner">
                <div class="charity-topbar-left">
                    <span>♥</span>
                    <span>Chung tay sẻ chia – Lan tỏa yêu thương</span>
                </div>

                <div class="charity-topbar-right">
                    <span>Trao yêu thương, nhận hạnh phúc</span>
                </div>
            </div>
        </div>

        <!-- Thanh điều hướng chính -->
        <nav class="navbar navbar-expand-lg charity-navbar">

            <div class="container">

                <!-- Logo -->
                @Html.ActionLink(
                                   "CHARITY",
                                   "Index",
                                   "Home",
                                   new { area = "" },
                                   new { @class = "navbar-brand charity-brand" }
                               )

                <!-- Nút menu mobile -->
                <button class="navbar-toggler charity-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu điều hướng">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Nội dung menu -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Menu chính -->
                    <ul class="navbar-nav charity-nav mx-auto">

                        <li class="nav-item">
                            @Html.ActionLink(
                                               "Trang chủ",
                                               "Index",
                                               "Home",
                                               new { area = "" },
                                               new { @class = "nav-link" }
                                           )
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                               "Chiến dịch",
                                               "Index",
                                               "Campaign",
                                               new { area = "" },
                                               new { @class = "nav-link" }
                                           )
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                               "Giới thiệu",
                                               "GioiThieu",
                                               "Home",
                                               new { area = "" },
                                               new { @class = "nav-link" }
                                           )
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                               "Liên hệ",
                                               "LienHe",
                                               "Home",
                                               new { area = "" },
                                               new { @class = "nav-link" }
                                           )
                        </li>

                    </ul>

                    <!-- Khu vực tài khoản -->
                    <div class="charity-account">

                        @if (Session["UserId"] != null)
                        {
                            <span class="charity-welcome">
                                Xin chào, @Session["FullName"]
                            </span>

                            @Html.ActionLink(
                                               "Đăng xuất",
                                               "Logout",
                                               "Account",
                                               new { area = "" },
                                               new { @class = "charity-login-link" }
                                           )
                        }
                        else
                        {
                            @Html.ActionLink(
                                               "Đăng nhập",
                                               "Login",
                                               "Account",
                                               new { area = "" },
                                               new { @class = "charity-login-link" }
                                           )

                            @Html.ActionLink(
                                               "Tham gia ngay",
                                               "Register",
                                               "Account",
                                               new { area = "" },
                                               new { @class = "charity-register-btn" }
                                           )
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- END CHARITY HEADER -->
    <!-- Nội dung từng trang -->
    <div class="body-content flex-grow-1">
        @RenderBody()
    </div>

    <!-- Chân trang -->
    <!-- ================================
         CHARITY FOOTER
    ================================= -->

    <footer class="charity-footer">

        <div class="container">

            <div class="row charity-footer-main">

                <!-- Cột 1: Thương hiệu -->
                <div class="col-lg-4 col-md-6 footer-column">

                    <a href="@Url.Action("Index", "Home")"
                       class="footer-brand">
                        <span class="footer-brand-icon">♥</span>
                        CHARITY
                    </a>

                    <p class="footer-description">
                        Chúng tôi tin rằng mỗi hành động sẻ chia,
                        dù nhỏ bé, đều có thể tạo nên những thay đổi
                        tích cực cho cộng đồng.
                    </p>

                    <div class="footer-slogan">
                        Chung tay hôm nay – Thay đổi ngày mai.
                    </div>

                </div>

                <!-- Cột 2: Liên kết -->
                <div class="col-lg-2 col-md-6 footer-column">

                    <h5>Khám phá</h5>

                    <ul class="footer-links">

                        <li>
                            @Html.ActionLink(
                                          "Trang chủ", "Index", "Home"
                                      )
                        </li>

                        <li>
                            @Html.ActionLink(
                                          "Chiến dịch", "Index", "Campaign"
                                      )
                        </li>

                        <li>
                            @Html.ActionLink(
                                          "Giới thiệu", "GioiThieu", "Home"
                                      )
                        </li>

                        <li>
                            @Html.ActionLink(
                                          "Liên hệ", "LienHe", "Home"
                                      )
                        </li>

                    </ul>

                </div>

                <!-- Cột 3: Hoạt động -->
                <div class="col-lg-3 col-md-6 footer-column">

                    <h5>Hoạt động</h5>

                    <ul class="footer-links">

                        <li>
                            <span>Hỗ trợ cộng đồng</span>
                        </li>

                        <li>
                            <span>Chương trình thiện nguyện</span>
                        </li>

                        <li>
                            <span>Kết nối nhà hảo tâm</span>
                        </li>

                        <li>
                            <span>Lan tỏa yêu thương</span>
                        </li>

                    </ul>

                </div>

                <!-- Cột 4: Kết nối -->
                <div class="col-lg-3 col-md-6 footer-column">

                    <h5>Kết nối với chúng tôi</h5>

                    <p class="footer-contact-text">
                        Hãy cùng CHARITY tạo nên những điều tốt đẹp
                        cho xã hội.
                    </p>

                    @Html.ActionLink(
                                  "Liên hệ với chúng tôi →",
                                  "LienHe",
                                  "Home",
                                  new { area = "" },
                                  new { @class = "footer-contact-link" }
                              )

                </div>

            </div>

            <!-- Dòng bản quyền -->
            <div class="charity-footer-bottom">

                <p>
                    &copy; @DateTime.Now.Year CHARITY.
                    All Rights Reserved.
                </p>

                <p>
                    Made with
                    <span class="footer-heart">♥</span>
                    for the community.
                </p>

            </div>

        </div>

    </footer>

    <!-- END CHARITY FOOTER -->


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>