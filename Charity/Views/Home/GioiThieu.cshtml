
@{
    ViewBag.Title = "Giới thiệu";
}

@section styles {
    <link href="@Url.Content("~/Content/charity-pages.css")" rel="stylesheet" />
}

<main class="charity-pages">

    <!-- HERO -->
    <section class="inner-hero">
        <div class="container page-container">
            <span class="page-eyebrow">VỀ CHARITY</span>
            <h1>Lan tỏa yêu thương,<br /><span>kết nối cộng đồng.</span></h1>
            <p>
                Một nền tảng kết nối những tấm lòng nhân ái
                với những hoàn cảnh cần được sẻ chia.
            </p>
            <div class="page-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <span>/</span>
                <strong>Giới thiệu</strong>
            </div>
        </div>
    </section>

    <!-- INTRODUCTION -->
    <section class="about-main-section">
        <div class="container page-container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="page-image-frame">
                        <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1200&q=85"
                             alt="Hoạt động thiện nguyện cộng đồng"
                             loading="lazy" />
                        <div class="image-caption">
                            <strong>CHARITY</strong>
                            <span>Chung tay vì cộng đồng</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <span class="page-eyebrow">CÂU CHUYỆN CỦA CHÚNG TÔI</span>
                    <h2 class="page-heading">
                        Mỗi sự sẻ chia đều<br />
                        <span>mang một ý nghĩa riêng.</span>
                    </h2>
                    <p>
                        CHARITY là nền tảng hỗ trợ kết nối những người
                        có mong muốn đóng góp với các chiến dịch
                        thiện nguyện vì cộng đồng.
                    </p>
                    <p>
                        Chúng tôi hướng đến việc giúp người dùng dễ dàng
                        tìm hiểu chiến dịch, theo dõi mục tiêu gây quỹ
                        và thực hiện quyên góp.
                    </p>
                    <p>
                        Với tinh thần tương thân tương ái, CHARITY mong
                        muốn góp phần xây dựng một cộng đồng biết quan tâm,
                        chia sẻ và đồng hành cùng nhau.
                    </p>
                    <a href="@Url.Action("Index", "Campaign")"
                       class="page-primary-btn">
                        Khám phá chiến dịch →
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- MISSION AND VISION -->
    <section class="about-values-section">
        <div class="container page-container">
            <div class="page-section-heading">
                <span class="page-eyebrow">ĐỊNH HƯỚNG PHÁT TRIỂN</span>
                <h2 class="page-heading">Điều CHARITY hướng đến</h2>
                <p>
                    Những giá trị làm nền tảng cho hoạt động của chúng tôi.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <article class="value-card">
                        <div class="value-icon">♡</div>
                        <h3>Sứ mệnh</h3>
                        <p>
                            Kết nối những tấm lòng nhân ái với các hoàn cảnh
                            cần hỗ trợ, tạo điều kiện để mọi người tham gia
                            hoạt động thiện nguyện một cách thuận tiện.
                        </p>
                    </article>
                </div>
                <div class="col-md-6">
                    <article class="value-card">
                        <div class="value-icon">✦</div>
                        <h3>Tầm nhìn</h3>
                        <p>
                            Hướng đến một cộng đồng nơi tinh thần sẻ chia
                            được lan tỏa, các hoạt động thiện nguyện được
                            kết nối và nhiều người có cơ hội chung tay.
                        </p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE VALUES -->
    <section class="about-core-section">
        <div class="container page-container">
            <div class="page-section-heading">
                <span class="page-eyebrow">GIÁ TRỊ CỐT LÕI</span>
                <h2 class="page-heading">Những giá trị chúng tôi theo đuổi</h2>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <article class="core-card">
                        <span>01</span>
                        <div class="value-icon">♡</div>
                        <h3>Nhân ái</h3>
                        <p>Đặt tinh thần sẻ chia và sự quan tâm cộng đồng lên hàng đầu.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="core-card">
                        <span>02</span>
                        <div class="value-icon">✓</div>
                        <h3>Minh bạch</h3>
                        <p>Khuyến khích thông tin chiến dịch và tiến độ rõ ràng.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="core-card">
                        <span>03</span>
                        <div class="value-icon">♧</div>
                        <h3>Kết nối</h3>
                        <p>Tạo cầu nối giữa người đóng góp và những hoàn cảnh cần hỗ trợ.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="core-card">
                        <span>04</span>
                        <div class="value-icon">✦</div>
                        <h3>Lan tỏa</h3>
                        <p>Khuyến khích những hành động tích cực trong cộng đồng.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="page-cta-section">
        <div class="container page-container">
            <div class="page-cta-box">
                <span class="page-eyebrow">HÀNH TRÌNH SẺ CHIA</span>
                <h2>Cùng CHARITY tạo nên<br />những điều tốt đẹp.</h2>
                <p>Mỗi hành động tử tế đều có thể tạo nên sự khác biệt.</p>
                <a href="@Url.Action("Index", "Campaign")"
                   class="page-white-btn">
                    Đồng hành cùng chúng tôi →
                </a>
            </div>
        </div>
    </section>

</main>
