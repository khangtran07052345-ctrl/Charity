
@model List<Charity.Models.CampaignViewModel>
@using System.Globalization
@using System.Linq

@{
    ViewBag.Title = "Trang chủ";
    var vi = new CultureInfo("vi-VN");
}

@section styles {
    <link href="@Url.Content("~/Content/charity-home.css")"
          rel="stylesheet" />
}

<div class="charity-home">

    <!-- 1. HERO BANNER -->
    <section class="home-hero">
        <div class="container home-container">
            <div class="row align-items-center">

                <div class="col-lg-6">
                    <div class="hero-content">

                        <div class="hero-label">
                            <span class="hero-label-dot"></span>
                            CÙNG NHAU LAN TỎA YÊU THƯƠNG
                        </div>

                        <h1>
                            Một hành động nhỏ,
                            <span>ngàn hy vọng lớn.</span>
                        </h1>

                        <p class="hero-description">
                            Mỗi sự sẻ chia đều có thể thay đổi một cuộc đời.
                            Hãy cùng CHARITY kết nối những tấm lòng nhân ái,
                            chung tay hỗ trợ cộng đồng và xây dựng một tương
                            lai tốt đẹp hơn.
                        </p>

                        <div class="hero-actions">
                            <a href="@Url.Action("Index", "Campaign")"
                               class="home-btn home-btn-primary">
                                Khám phá chiến dịch <span>→</span>
                            </a>

                            <a href="@Url.Action("GioiThieu", "Home")"
                               class="home-btn home-btn-outline">
                                Tìm hiểu về chúng tôi
                            </a>
                        </div>

                        <div class="hero-trust">
                            <div class="hero-trust-icon">♥</div>
                            <div>
                                <strong>Trao đi yêu thương</strong>
                                <span>Kết nối những trái tim nhân ái</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hero-visual">

                        <div class="hero-image-main">
                            <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=85"
                                 alt="Hoạt động thiện nguyện hỗ trợ trẻ em" />
                        </div>

                        <div class="hero-image-decoration"></div>

                        <div class="hero-floating-card">
                            <div class="floating-card-icon">♥</div>
                            <div>
                                <strong>Lan tỏa yêu thương</strong>
                                <span>Mỗi đóng góp đều ý nghĩa</span>
                            </div>
                        </div>

                        <div class="hero-image-caption">
                            <span>SHARE LOVE</span>
                            <span>CHANGE LIVES</span>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 2. TRUST SECTION -->
    <section class="home-trust-section">
        <div class="container home-container">
            <div class="row">

                <div class="col-md-4">
                    <div class="trust-item">
                        <div class="trust-icon trust-blue">✓</div>
                        <div>
                            <h3>Minh bạch</h3>
                            <p>
                                Hướng đến sự rõ ràng trong từng hoạt động
                                và nguồn đóng góp.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="trust-item">
                        <div class="trust-icon trust-green">♡</div>
                        <div>
                            <h3>Nhân ái</h3>
                            <p>
                                Kết nối những tấm lòng sẻ chia,
                                cùng hỗ trợ người cần giúp đỡ.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="trust-item">
                        <div class="trust-icon trust-orange">✦</div>
                        <div>
                            <h3>Lan tỏa</h3>
                            <p>
                                Góp phần xây dựng một cộng đồng
                                đoàn kết và tốt đẹp hơn.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 3. FEATURED CAMPAIGNS -->
    <section class="home-campaign-section" id="chien-dich">
        <div class="container home-container">

            <div class="section-heading-wrap">
                <div>
                    <span class="section-eyebrow">
                        CHUNG TAY VÌ CỘNG ĐỒNG
                    </span>

                    <h2 class="home-section-title">
                        Những chiến dịch nổi bật
                    </h2>

                    <p class="home-section-description">
                        Mỗi chiến dịch là một cơ hội để chúng ta
                        mang đến những điều tốt đẹp cho cuộc sống.
                    </p>
                </div>

                <a href="@Url.Action("Index", "Campaign")"
                   class="section-view-all">
                    Xem tất cả chiến dịch →
                </a>
            </div>

            <div class="row">

                @if (Model == null || !Model.Any())
                {
                    <div class="col-12">
                        <div class="home-empty-state">
                            <div class="empty-icon">♡</div>
                            <h3>Chưa có chiến dịch nổi bật</h3>
                            <p>
                                Hiện tại chưa có chiến dịch nào đang diễn ra.
                                Hãy quay lại sau nhé!
                            </p>

                            <a href="@Url.Action("Index", "Campaign")"
                               class="home-btn home-btn-primary">
                                Khám phá chiến dịch
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        var progress = Math.Max(
                            0,
                            Math.Min(100, c.ProgressPercent)
                        );

                        <div class="col-12 col-sm-6 col-xl-3 mb-4">

                            <article class="home-campaign-card">

                                <div class="campaign-image-wrap">

                                    @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                    {
                                        <img src="@Url.Content(c.ImageUrl)"
                                             alt="@c.Title"
                   
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/Content/Image/images (4).jpg")"
                                             alt="@c.Title" />
                                    }

                                    <span class="campaign-status @c.StatusBadgeClass">
                                        @c.StatusText
                                    </span>
                                </div>

                                <div class="home-campaign-content">

                                    <h3 title="@c.Title">
                                        @c.Title
                                    </h3>

                                    <p class="campaign-description">
                                        @c.Description
                                    </p>

                                    <div class="campaign-progress-heading">
                                        <span>Đã quyên góp</span>
                                        <strong>@progress%</strong>
                                    </div>

                                    <div class="campaign-progress-track">
                                        <div class="campaign-progress-fill"
                                             style="width:@progress%;"></div>
                                    </div>

                                    <div class="campaign-money">
                                        <div>
                                            <strong>
                                                @c.RaisedAmount.ToString("N0", vi)đ
                                            </strong>
                                            <span>Đã nhận</span>
                                        </div>

                                        <div class="campaign-target">
                                            <strong>
                                                @c.TargetAmount.ToString("N0", vi)đ
                                            </strong>
                                            <span>Mục tiêu</span>
                                        </div>
                                    </div>

                                    <a href="@Url.Action("Details", "Campaign", new { id = c.Id })"
                                       class="campaign-detail-btn">
                                        Xem chi tiết <span>→</span>
                                    </a>

                                </div>
                            </article>
                        </div>
                    }
                }

            </div>
        </div>
    </section>

    <!-- 4. IMPACT STATISTICS -->
    <section class="home-impact-section">
        <div class="container home-container">

            <div class="impact-heading">
                <span class="section-eyebrow impact-eyebrow">
                    GIÁ TRỊ CỦA SỰ SẺ CHIA
                </span>

                <h2>
                    Cùng nhau tạo nên
                    <span>những điều ý nghĩa</span>
                </h2>

                <p>
                    Một cộng đồng tốt đẹp được tạo nên từ những
                    hành động tử tế mỗi ngày.
                </p>
            </div>

            <div class="row impact-grid">

                <div class="col-6 col-lg-3 mb-3">
                    <div class="impact-card">
                        <div class="impact-icon">♡</div>
                        <div class="impact-number" data-count="12">12</div>
                        <p>Chiến dịch minh họa</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3 mb-3">
                    <div class="impact-card">
                        <div class="impact-icon">♧</div>
                        <div class="impact-number" data-count="5280">5.280</div>
                        <p>Nhà hảo tâm minh họa</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3 mb-3">
                    <div class="impact-card">
                        <div class="impact-icon">₫</div>
                        <div class="impact-number" data-count="1200">1.200</div>
                        <p>Triệu đồng minh họa</p>
                    </div>
                </div>

                <div class="col-6 col-lg-3 mb-3">
                    <div class="impact-card">
                        <div class="impact-icon">✦</div>
                        <div class="impact-number" data-count="8600">8.600</div>
                        <p>Lượt hỗ trợ minh họa</p>
                    </div>
                </div>

            </div>

            <p class="impact-note">
                * Các số liệu trên là dữ liệu minh họa phục vụ giao diện đồ án.
            </p>

        </div>
    </section>

    <!-- 5. HOW IT WORKS -->
    <section class="home-process-section">
        <div class="container home-container">

            <div class="section-heading-wrap">
                <div>
                    <span class="section-eyebrow">
                        BẮT ĐẦU TỪ NHỮNG ĐIỀU NHỎ BÉ
                    </span>

                    <h2 class="home-section-title">
                        Đồng hành cùng CHARITY
                    </h2>

                    <p class="home-section-description">
                        Chỉ với ba bước đơn giản, bạn đã có thể
                        tìm hiểu và chung tay cùng cộng đồng.
                    </p>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-4">
                    <div class="process-card">
                        <div class="process-number">01</div>
                        <div class="process-icon">⌕</div>
                        <h3>Khám phá</h3>
                        <p>
                            Tìm hiểu các chiến dịch thiện nguyện
                            và những hoàn cảnh đang cần được hỗ trợ.
                        </p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="process-card">
                        <div class="process-number">02</div>
                        <div class="process-icon">♡</div>
                        <h3>Kết nối</h3>
                        <p>
                            Lựa chọn chiến dịch phù hợp và tìm hiểu
                            thông tin trước khi tham gia.
                        </p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="process-card">
                        <div class="process-number">03</div>
                        <div class="process-icon">✦</div>
                        <h3>Lan tỏa</h3>
                        <p>
                            Cùng chia sẻ những giá trị tích cực
                            và góp phần tạo nên thay đổi tốt đẹp.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 6. ABOUT CHARITY -->
    <section class="home-about-section">
        <div class="container home-container">

            <div class="row align-items-center">

                <div class="col-lg-6 mb-4">
                    <div class="about-image-wrap">

                        <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1200&q=85"
                             alt="Hoạt động cộng đồng" />

                        <div class="about-image-label">
                            <span>♥</span>
                            SẺ CHIA ĐỂ YÊU THƯƠNG
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="about-content">

                        <span class="section-eyebrow">
                            VỀ CHÚNG TÔI
                        </span>

                        <h2>
                            CHARITY – Nơi
                            <span>yêu thương được kết nối</span>
                        </h2>

                        <p>
                            CHARITY hướng đến việc xây dựng một cầu nối
                            giữa những tấm lòng nhân ái và những hoàn cảnh
                            cần được sẻ chia.
                        </p>

                        <p>
                            Chúng tôi mong muốn góp phần lan tỏa tinh thần
                            tương thân tương ái, khuyến khích mọi người
                            cùng tham gia những hoạt động có ý nghĩa
                            cho cộng đồng.
                        </p>

                        <div class="about-highlight">
                            <span class="about-check">✓</span>
                            <div>
                                <strong>Kết nối cộng đồng</strong>
                                <p>Gắn kết những trái tim cùng chung mục tiêu.</p>
                            </div>
                        </div>

                        <div class="about-highlight">
                            <span class="about-check">✓</span>
                            <div>
                                <strong>Lan tỏa giá trị nhân văn</strong>
                                <p>Góp phần mang đến hy vọng và sự sẻ chia.</p>
                            </div>
                        </div>

                        <a href="@Url.Action("GioiThieu", "Home")"
                           class="home-btn home-btn-primary about-button">
                            Tìm hiểu thêm về CHARITY →
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 7. CALL TO ACTION -->
    <section class="home-cta-section">
        <div class="container home-container">

            <div class="home-cta-box">

                <div class="cta-decoration cta-decoration-one"></div>
                <div class="cta-decoration cta-decoration-two"></div>

                <div class="cta-content">

                    <span class="cta-eyebrow">
                        MỘT HÀNH ĐỘNG – NGÀN YÊU THƯƠNG
                    </span>

                    <h2>
                        Hãy cùng chúng tôi
                        tạo nên sự khác biệt!
                    </h2>

                    <p>
                        Đừng chờ đợi những điều lớn lao.
                        Hãy bắt đầu từ một hành động tử tế hôm nay.
                    </p>

                    <a href="@Url.Action("Index", "Campaign")"
                       class="home-btn home-btn-white">
                        Khám phá các chiến dịch →
                    </a>

                </div>
            </div>

        </div>
    </section>

</div>
